# ——————————————————————————————————————————————————
# Momo — Environment Variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local to git.
# ——————————————————————————————————————————————————

# Supabase — get these from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Anthropic — get an API key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Resend — for sending family announcements (https://resend.com/api-keys)
# Free tier: 3,000 emails/month, 100/day. Use onboarding@resend.dev as sender for testing.
RESEND_API_KEY=re_your_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
